# Copy to .env, or run `make env` to generate one with random values. Never commit .env.

# Signs the login cookie. Any long random string; changing it logs everyone out.
LSO_SECRET=change-me-to-a-long-random-string

# The GM's passcode. Players don't need one: they pick their character on the login screen.
# Case and spaces don't matter when typing it.
LSO_GM_PASSCODE=ember-0000

# Bump to log every device out at once.
LSO_AUTH_EPOCH=1

# Set to 1 when served over https (Railway). Leave 0 for http://localhost and LAN testing.
LSO_SECURE_COOKIES=0

# Host port for `make up` (8000 and 8001 are taken by other projects on this Mac).
# LSO_PORT=8070

# Extra origins allowed to open the WebSocket, comma separated (rarely needed).
# LSO_ALLOWED_ORIGINS=http://192.168.1.20:5173

# The join card on the TV and the GM's TV section. No URL, no card (leave these out on a public server).
# Only the TV and the GM's screens get them. Single quotes keep a password's $ and # as typed.
# LSO_JOIN_URL=http://parker.local
# LSO_JOIN_FALLBACK=http://192.168.1.4
# LSO_WIFI_SSID=YourNetwork
# LSO_WIFI_PASSWORD='your password'
